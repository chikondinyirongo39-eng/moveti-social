'use client'

import Link from 'next/link'
import { useEffect, useState } from 'react'

type Profile = {
  name: string
  username: string
  bio: string
  avatar: string
  cover: string
  followers: number
  following: number
}

type Post = {
  id: string
  content: string
  created_at: string
  likes?: number
  comments?: number
}

export default function ProfilePage() {
  const [profile, setProfile] = useState<Profile>({
    name: 'MOVETI User',
    username: 'movetiuser',
    bio: 'Welcome to MOVETI.',
    avatar: '',
    cover: '',
    followers: 0,
    following: 0,
  })

  const [posts, setPosts] = useState<Post[]>([])
  const [activeTab, setActiveTab] = useState('posts')
  const [loading, setLoading] = useState(true)

  useEffect(() => {
    const loadProfile = async () => {
      try {
        setLoading(true)

        const response = await fetch('/api/search?q=me', {
          cache: 'no-store',
        })

        if (response.ok) {
          const data = await response.json()

          const candidate =
            Array.isArray(data)
              ? data[0]
              : data?.profile ||
                data?.profiles?.[0] ||
                data?.users?.[0] ||
                data?.results?.[0]

          if (candidate) {
            setProfile({
              name:
                candidate.full_name ||
                candidate.display_name ||
                candidate.name ||
                'MOVETI User',
              username:
                candidate.username ||
                candidate.handle ||
                'movetiuser',
              bio: candidate.bio || 'Welcome to MOVETI.',
              avatar:
                candidate.avatar_url ||
                candidate.avatar ||
                candidate.profile_image ||
                '',
              cover:
                candidate.cover_url ||
                candidate.cover ||
                candidate.cover_image ||
                '',
              followers: Number(candidate.followers || 0),
              following: Number(candidate.following || 0),
            })
          }
        }

        const postsResponse = await fetch('/api/posts', {
          cache: 'no-store',
        })

        if (postsResponse.ok) {
          const data = await postsResponse.json()

          if (Array.isArray(data)) {
            setPosts(data.slice(0, 30))
          }
        }
      } catch {
        // Keep the safe profile defaults.
      } finally {
        setLoading(false)
      }
    }

    loadProfile()
  }, [])

  const shareProfile = async () => {
    const url = window.location.href

    try {
      if (navigator.share) {
        await navigator.share({
          title: `${profile.name} on MOVETI`,
          text: `View ${profile.name} on MOVETI`,
          url,
        })
      } else {
        await navigator.clipboard.writeText(url)
      }
    } catch {
      // Sharing can be cancelled by the user.
    }
  }

  return (
    <main className="min-h-screen bg-black text-white">
      <div className="mx-auto min-h-screen w-full max-w-md border-x border-white/[0.04]">
        <header className="sticky top-0 z-50 flex items-center justify-between border-b border-white/10 bg-black/90 px-5 py-4 backdrop-blur-xl">
          <div>
            <p className="text-[10px] font-bold uppercase tracking-[0.3em] text-white/30">
              Your account
            </p>
            <h1 className="mt-1 text-xl font-black">Profile</h1>
          </div>

          <Link
            href="/settings"
            className="flex h-10 w-10 items-center justify-center rounded-full bg-white/[0.06] text-lg text-white/60"
            aria-label="Settings"
          >
            ⚙
          </Link>
        </header>

        <section className="relative">
          <div className="h-40 overflow-hidden bg-gradient-to-br from-fuchsia-700/40 via-purple-800/30 to-blue-700/40">
            {profile.cover ? (
              <img
                src={profile.cover}
                alt=""
                className="h-full w-full object-cover"
              />
            ) : (
              <div className="h-full w-full bg-[radial-gradient(circle_at_20%_20%,rgba(217,70,239,0.45),transparent_35%),radial-gradient(circle_at_80%_20%,rgba(59,130,246,0.35),transparent_35%),linear-gradient(135deg,#09000f,#080812,#000)]" />
            )}

            <div className="absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-transparent to-black/80" />
          </div>

          <div className="relative px-5">
            <div className="-mt-14 flex items-end justify-between">
              <div className="flex h-28 w-28 items-center justify-center overflow-hidden rounded-full border-4 border-black bg-gradient-to-br from-fuchsia-500 via-purple-500 to-blue-500 shadow-2xl">
                {profile.avatar ? (
                  <img
                    src={profile.avatar}
                    alt={profile.name}
                    className="h-full w-full object-cover"
                  />
                ) : (
                  <span className="text-4xl font-black">
                    {profile.name.charAt(0).toUpperCase()}
                  </span>
                )}
              </div>

              <div className="mb-1 flex gap-2">
                <Link
                  href="/settings"
                  className="rounded-full border border-white/15 bg-white/[0.06] px-5 py-2.5 text-xs font-black"
                >
                  Edit Profile
                </Link>

                <button
                  onClick={shareProfile}
                  className="flex h-10 w-10 items-center justify-center rounded-full border border-white/15 bg-white/[0.06] text-sm"
                  aria-label="Share profile"
                >
                  ↗
                </button>
              </div>
            </div>

            <div className="pt-4">
              <h2 className="text-2xl font-black tracking-tight">
                {profile.name}
              </h2>

              <p className="mt-1 text-sm text-white/40">
                @{profile.username}
              </p>

              <p className="mt-4 text-sm leading-6 text-white/65">
                {profile.bio}
              </p>

              <div className="mt-5 flex gap-7">
                <Stat value={posts.length} label="Posts" />
                <Stat value={profile.followers} label="Followers" />
                <Stat value={profile.following} label="Following" />
              </div>
            </div>
          </div>
        </section>

        <section className="px-5 pt-6">
          <div className="grid grid-cols-3 gap-2">
            <Link
              href="/creator"
              className="rounded-2xl border border-fuchsia-500/20 bg-fuchsia-500/10 px-3 py-4"
            >
              <div className="text-lg">♫</div>
              <p className="mt-2 text-xs font-black">Creator</p>
              <p className="mt-1 text-[10px] text-white/35">
                Studio
              </p>
            </Link>

            <Link
              href="/music"
              className="rounded-2xl border border-white/10 bg-white/[0.04] px-3 py-4"
            >
              <div className="text-lg">◉</div>
              <p className="mt-2 text-xs font-black">Music</p>
              <p className="mt-1 text-[10px] text-white/35">
                Your music
              </p>
            </Link>

            <Link
              href="/create"
              className="rounded-2xl border border-white/10 bg-white/[0.04] px-3 py-4"
            >
              <div className="text-lg">+</div>
              <p className="mt-2 text-xs font-black">Create</p>
              <p className="mt-1 text-[10px] text-white/35">
                New post
              </p>
            </Link>
          </div>
        </section>

        <div className="mt-6 grid grid-cols-3 border-y border-white/10">
          {[
            ['posts', 'Posts', '▦'],
            ['reels', 'Reels', '▶'],
            ['tagged', 'Tagged', '♢'],
          ].map(([value, label, icon]) => (
            <button
              key={value}
              onClick={() => setActiveTab(value)}
              className={`relative flex flex-col items-center gap-1 py-4 text-xs font-black ${
                activeTab === value ? 'text-white' : 'text-white/30'
              }`}
            >
              <span className="text-lg">{icon}</span>
              {label}

              {activeTab === value && (
                <span className="absolute inset-x-8 bottom-0 h-0.5 rounded-full bg-fuchsia-500" />
              )}
            </button>
          ))}
        </div>

        <section className="px-5 pb-28 pt-5">
          {loading ? (
            <div className="space-y-3">
              <div className="h-32 animate-pulse rounded-2xl bg-white/[0.05]" />
              <div className="h-32 animate-pulse rounded-2xl bg-white/[0.05]" />
              <div className="h-32 animate-pulse rounded-2xl bg-white/[0.05]" />
            </div>
          ) : activeTab === 'posts' ? (
            posts.length > 0 ? (
              <div className="space-y-3">
                {posts.map((post) => (
                  <article
                    key={post.id}
                    className="rounded-3xl border border-white/10 bg-white/[0.035] p-4"
                  >
                    <div className="flex items-center gap-3">
                      <div className="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-fuchsia-500 to-blue-500 text-sm font-black">
                        {profile.name.charAt(0).toUpperCase()}
                      </div>

                      <div>
                        <p className="text-xs font-black">
                          {profile.name}
                        </p>
                        <p className="text-[10px] text-white/30">
                          {formatDate(post.created_at)}
                        </p>
                      </div>
                    </div>

                    <p className="mt-4 text-sm leading-6 text-white/75">
                      {post.content}
                    </p>

                    <div className="mt-5 flex items-center gap-6 text-[11px] font-semibold text-white/35">
                      <span>♥ {post.likes || 0}</span>
                      <span>
                        Comments {post.comments || 0}
                      </span>
                      <span>Share</span>
                    </div>
                  </article>
                ))}
              </div>
            ) : (
              <EmptyState
                icon="▦"
                title="No posts yet"
                text="Posts you create on MOVETI will appear here."
                href="/create"
                action="Create a post"
              />
            )
          ) : activeTab === 'reels' ? (
            <EmptyState
              icon="▶"
              title="No reels yet"
              text="Your short videos and reels will appear here."
              href="/create"
              action="Create a reel"
            />
          ) : (
            <EmptyState
              icon="♢"
              title="No tagged posts"
              text="Posts where you are tagged will appear here."
            />
          )}
        </section>

        <nav className="fixed bottom-0 left-1/2 z-50 grid w-full max-w-md -translate-x-1/2 grid-cols-5 border-t border-white/10 bg-black/95 px-2 py-3 backdrop-blur-xl">
          <NavItem href="/" icon="⌂" label="Home" />
          <NavItem href="/discover" icon="⌕" label="Discover" />
          <NavItem href="/create" icon="+" label="Create" create />
          <NavItem href="/messages" icon="◇" label="Messages" />
          <NavItem
            href="/profile"
            icon="◯"
            label="Profile"
            active
          />
        </nav>
      </div>
    </main>
  )
}

function Stat({
  value,
  label,
}: {
  value: number
  label: string
}) {
  return (
    <div>
      <p className="text-lg font-black">{value}</p>
      <p className="text-[10px] font-bold uppercase tracking-wider text-white/30">
        {label}
      </p>
    </div>
  )
}

function EmptyState({
  icon,
  title,
  text,
  href,
  action,
}: {
  icon: string
  title: string
  text: string
  href?: string
  action?: string
}) {
  return (
    <div className="rounded-3xl border border-white/10 bg-white/[0.03] px-6 py-12 text-center">
      <div className="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-white/[0.06] text-2xl">
        {icon}
      </div>

      <h3 className="mt-5 text-lg font-black">{title}</h3>

      <p className="mt-2 text-sm leading-6 text-white/40">
        {text}
      </p>

      {href && action && (
        <Link
          href={href}
          className="mt-5 inline-flex rounded-full bg-white px-5 py-2.5 text-xs font-black text-black"
        >
          {action}
        </Link>
      )}
    </div>
  )
}

function NavItem({
  href,
  icon,
  label,
  active = false,
  create = false,
}: {
  href: string
  icon: string
  label: string
  active?: boolean
  create?: boolean
}) {
  return (
    <Link
      href={href}
      className={`flex flex-col items-center gap-1 py-1 text-[10px] font-semibold ${
        active ? 'text-fuchsia-400' : 'text-white/40'
      }`}
    >
      {create ? (
        <span className="flex h-7 w-7 items-center justify-center rounded-full bg-white text-lg text-black">
          {icon}
        </span>
      ) : (
        <span className="text-lg">{icon}</span>
      )}

      {label}
    </Link>
  )
}

function formatDate(value?: string) {
  if (!value) return ''

  const date = new Date(value)

  if (Number.isNaN(date.getTime())) return ''

  return date.toLocaleDateString(undefined, {
    month: 'short',
    day: 'numeric',
  })
}
