'use client'

import Link from 'next/link'
import { useEffect, useState } from 'react'

type Message = {
  id: string
  sender_id?: string
  receiver_id?: string
  content: string
  created_at: string
  read?: boolean
  sender_name?: string
  sender_avatar?: string
}

type Conversation = {
  id: string
  name: string
  username: string
  avatar: string
  lastMessage: string
  time: string
  unread: number
}

export default function MessagesPage() {
  const [search, setSearch] = useState('')
  const [activeConversation, setActiveConversation] =
    useState<Conversation | null>(null)
  const [messageText, setMessageText] = useState('')
  const [messages, setMessages] = useState<Message[]>([])
  const [loading, setLoading] = useState(true)
  const [sending, setSending] = useState(false)

  const [conversations, setConversations] = useState<Conversation[]>([])

  useEffect(() => {
    const loadMessages = async () => {
      try {
        setLoading(true)

        const response = await fetch('/api/messages', {
          cache: 'no-store',
        })

        if (!response.ok) {
          setConversations([])
          return
        }

        const data = await response.json()

        const source = Array.isArray(data)
          ? data
          : data?.messages || data?.conversations || data?.data || []

        if (!Array.isArray(source)) {
          setConversations([])
          return
        }

        const grouped = new Map<string, Conversation>()

        source.forEach((item: any, index: number) => {
          const conversationId =
            item.conversation_id ||
            item.sender_id ||
            item.receiver_id ||
            `conversation-${index}`

          const name =
            item.sender_name ||
            item.receiver_name ||
            item.name ||
            'MOVETI User'

          const username =
            item.username ||
            item.sender_username ||
            item.receiver_username ||
            'user'

          const avatar =
            item.sender_avatar ||
            item.receiver_avatar ||
            item.avatar_url ||
            item.avatar ||
            ''

          if (!grouped.has(conversationId)) {
            grouped.set(conversationId, {
              id: conversationId,
              name,
              username,
              avatar,
              lastMessage: item.content || 'New message',
              time: formatMessageTime(item.created_at),
              unread: item.read === false ? 1 : 0,
            })
          }
        })

        setConversations(Array.from(grouped.values()))
      } catch {
        setConversations([])
      } finally {
        setLoading(false)
      }
    }

    loadMessages()
  }, [])

  const filteredConversations = conversations.filter((conversation) => {
    const value = search.toLowerCase().trim()

    if (!value) return true

    return (
      conversation.name.toLowerCase().includes(value) ||
      conversation.username.toLowerCase().includes(value) ||
      conversation.lastMessage.toLowerCase().includes(value)
    )
  })

  const openConversation = async (conversation: Conversation) => {
    setActiveConversation(conversation)

    try {
      const response = await fetch(
        `/api/messages?conversation_id=${encodeURIComponent(conversation.id)}`,
        { cache: 'no-store' }
      )

      if (!response.ok) {
        setMessages([])
        return
      }

      const data = await response.json()

      const source = Array.isArray(data)
        ? data
        : data?.messages || data?.data || []

      setMessages(Array.isArray(source) ? source : [])
    } catch {
      setMessages([])
    }
  }

  const sendMessage = async () => {
    const text = messageText.trim()

    if (!text || !activeConversation || sending) return

    try {
      setSending(true)

      const response = await fetch('/api/messages', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          receiver_id: activeConversation.id,
          content: text,
        }),
      })

      if (response.ok) {
        const data = await response.json()

        const newMessage: Message = {
          id:
            data?.id ||
            data?.message?.id ||
            `local-${Date.now()}`,
          content: text,
          created_at: new Date().toISOString(),
          sender_id: 'me',
        }

        setMessages((current) => [...current, newMessage])
        setMessageText('')
      }
    } catch {
      // Keep the composer usable if the API is unavailable.
    } finally {
      setSending(false)
    }
  }

  if (activeConversation) {
    return (
      <ChatView
        conversation={activeConversation}
        messages={messages}
        messageText={messageText}
        setMessageText={setMessageText}
        onBack={() => setActiveConversation(null)}
        onSend={sendMessage}
        sending={sending}
      />
    )
  }

  return (
    <main className="min-h-screen bg-black text-white">
      <div className="mx-auto min-h-screen w-full max-w-md border-x border-white/[0.04]">
        <header className="sticky top-0 z-50 border-b border-white/10 bg-black/95 px-5 pb-4 pt-5 backdrop-blur-xl">
          <div className="flex items-center justify-between">
            <div>
              <p className="text-[10px] font-bold uppercase tracking-[0.3em] text-white/30">
                Social
              </p>
              <h1 className="mt-1 text-2xl font-black tracking-tight">
                Messages
              </h1>
            </div>

            <button
              className="flex h-11 w-11 items-center justify-center rounded-full bg-white/[0.06] text-lg text-white/70"
              aria-label="New message"
            >
              +
            </button>
          </div>

          <div className="mt-5 flex items-center gap-3 rounded-2xl border border-white/10 bg-white/[0.05] px-4 py-3">
            <span className="text-lg text-white/35">⌕</span>

            <input
              value={search}
              onChange={(event) => setSearch(event.target.value)}
              placeholder="Search messages"
              className="min-w-0 flex-1 bg-transparent text-sm text-white outline-none placeholder:text-white/30"
            />
          </div>
        </header>

        <section className="px-5 pt-5">
          <div className="grid grid-cols-2 gap-3">
            <button className="rounded-2xl border border-fuchsia-500/20 bg-fuchsia-500/10 px-4 py-4 text-left">
              <span className="text-lg">✉</span>
              <p className="mt-2 text-sm font-black">Chats</p>
              <p className="mt-1 text-[11px] text-white/35">
                Your conversations
              </p>
            </button>

            <button className="rounded-2xl border border-white/10 bg-white/[0.04] px-4 py-4 text-left">
              <span className="text-lg">♢</span>
              <p className="mt-2 text-sm font-black">Requests</p>
              <p className="mt-1 text-[11px] text-white/35">
                Message requests
              </p>
            </button>
          </div>
        </section>

        <section className="px-5 pb-28 pt-7">
          <div className="mb-4 flex items-center justify-between">
            <h2 className="text-sm font-black">Conversations</h2>

            <span className="text-[10px] font-bold uppercase tracking-wider text-white/25">
              {filteredConversations.length}
            </span>
          </div>

          {loading ? (
            <div className="space-y-3">
              {[1, 2, 3, 4].map((item) => (
                <div
                  key={item}
                  className="h-20 animate-pulse rounded-2xl bg-white/[0.05]"
                />
              ))}
            </div>
          ) : filteredConversations.length > 0 ? (
            <div className="space-y-2">
              {filteredConversations.map((conversation) => (
                <button
                  key={conversation.id}
                  onClick={() => openConversation(conversation)}
                  className="flex w-full items-center gap-3 rounded-2xl border border-white/10 bg-white/[0.035] p-3 text-left transition active:scale-[0.99]"
                >
                  <Avatar
                    name={conversation.name}
                    src={conversation.avatar}
                  />

                  <div className="min-w-0 flex-1">
                    <div className="flex items-center justify-between gap-3">
                      <h3 className="truncate text-sm font-black">
                        {conversation.name}
                      </h3>

                      <span className="shrink-0 text-[10px] text-white/25">
                        {conversation.time}
                      </span>
                    </div>

                    <div className="mt-1 flex items-center justify-between gap-3">
                      <p className="truncate text-xs text-white/40">
                        {conversation.lastMessage}
                      </p>

                      {conversation.unread > 0 && (
                        <span className="flex h-5 min-w-5 items-center justify-center rounded-full bg-fuchsia-500 px-1.5 text-[9px] font-black">
                          {conversation.unread}
                        </span>
                      )}
                    </div>
                  </div>
                </button>
              ))}
            </div>
          ) : (
            <div className="rounded-3xl border border-white/10 bg-white/[0.03] px-6 py-14 text-center">
              <div className="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-white/[0.06] text-2xl">
                ✉
              </div>

              <h3 className="mt-5 text-lg font-black">
                No conversations yet
              </h3>

              <p className="mt-2 text-sm leading-6 text-white/40">
                When you start chatting with people on MOVETI, your
                conversations will appear here.
              </p>
            </div>
          )}
        </section>

        <BottomNavigation active="messages" />
      </div>
    </main>
  )
}

function ChatView({
  conversation,
  messages,
  messageText,
  setMessageText,
  onBack,
  onSend,
  sending,
}: {
  conversation: Conversation
  messages: Message[]
  messageText: string
  setMessageText: (value: string) => void
  onBack: () => void
  onSend: () => void
  sending: boolean
}) {
  return (
    <main className="min-h-screen bg-black text-white">
      <div className="mx-auto flex min-h-screen w-full max-w-md flex-col border-x border-white/[0.04]">
        <header className="sticky top-0 z-50 flex items-center gap-3 border-b border-white/10 bg-black/95 px-4 py-3 backdrop-blur-xl">
          <button
            onClick={onBack}
            className="flex h-10 w-10 items-center justify-center rounded-full bg-white/[0.06] text-2xl"
            aria-label="Back"
          >
            ‹
          </button>

          <Avatar
            name={conversation.name}
            src={conversation.avatar}
            small
          />

          <div className="min-w-0 flex-1">
            <h1 className="truncate text-sm font-black">
              {conversation.name}
            </h1>

            <p className="truncate text-[11px] text-white/35">
              @{conversation.username}
            </p>
          </div>

          <button
            className="flex h-10 w-10 items-center justify-center rounded-full bg-white/[0.06] text-white/60"
            aria-label="Conversation options"
          >
            •••
          </button>
        </header>

        <section className="flex-1 space-y-3 overflow-y-auto px-4 pb-28 pt-5">
          {messages.length > 0 ? (
            messages.map((message) => {
              const mine =
                message.sender_id === 'me' ||
                message.sender_id === 'current-user'

              return (
                <div
                  key={message.id}
                  className={`flex ${
                    mine ? 'justify-end' : 'justify-start'
                  }`}
                >
                  <div
                    className={`max-w-[78%] rounded-2xl px-4 py-3 text-sm leading-5 ${
                      mine
                        ? 'rounded-br-md bg-fuchsia-600 text-white'
                        : 'rounded-bl-md bg-white/[0.08] text-white/80'
                    }`}
                  >
                    {message.content}

                    <p
                      className={`mt-1 text-[9px] ${
                        mine ? 'text-white/50' : 'text-white/25'
                      }`}
                    >
                      {formatMessageTime(message.created_at)}
                    </p>
                  </div>
                </div>
              )
            })
          ) : (
            <div className="flex min-h-[55vh] flex-col items-center justify-center text-center">
              <Avatar name={conversation.name} src={conversation.avatar} />

              <h2 className="mt-5 text-lg font-black">
                {conversation.name}
              </h2>

              <p className="mt-2 max-w-xs text-sm leading-6 text-white/35">
                Start a conversation with this MOVETI user.
              </p>
            </div>
          )}
        </section>

        <div className="fixed bottom-0 left-1/2 z-50 w-full max-w-md -translate-x-1/2 border-t border-white/10 bg-black/95 p-3 backdrop-blur-xl">
          <div className="flex items-end gap-2 rounded-2xl border border-white/10 bg-white/[0.05] p-2">
            <button
              className="mb-1 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/[0.06] text-white/50"
              aria-label="Add attachment"
            >
              +
            </button>

            <textarea
              value={messageText}
              onChange={(event) => setMessageText(event.target.value)}
              onKeyDown={(event) => {
                if (event.key === 'Enter' && !event.shiftKey) {
                  event.preventDefault()
                  onSend()
                }
              }}
              placeholder="Write a message..."
              rows={1}
              className="max-h-28 min-h-9 flex-1 resize-none bg-transparent px-1 py-2 text-sm text-white outline-none placeholder:text-white/30"
            />

            <button
              onClick={onSend}
              disabled={!messageText.trim() || sending}
              className="mb-1 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white text-black disabled:opacity-30"
              aria-label="Send message"
            >
              ↑
            </button>
          </div>
        </div>
      </div>
    </main>
  )
}

function Avatar({
  name,
  src,
  small = false,
}: {
  name: string
  src: string
  small?: boolean
}) {
  const size = small ? 'h-10 w-10' : 'h-14 w-14'

  return (
    <div
      className={`flex ${size} shrink-0 items-center justify-center overflow-hidden rounded-full bg-gradient-to-br from-fuchsia-500 via-purple-500 to-blue-500 font-black`}
    >
      {src ? (
        <img
          src={src}
          alt={name}
          className="h-full w-full object-cover"
        />
      ) : (
        <span className={small ? 'text-sm' : 'text-lg'}>
          {name.charAt(0).toUpperCase()}
        </span>
      )}
    </div>
  )
}

function BottomNavigation({ active }: { active: string }) {
  const items = [
    ['/', '⌂', 'Home', 'home'],
    ['/discover', '⌕', 'Discover', 'discover'],
    ['/create', '+', 'Create', 'create'],
    ['/messages', '◇', 'Messages', 'messages'],
    ['/profile', '◯', 'Profile', 'profile'],
  ]

  return (
    <nav className="fixed bottom-0 left-1/2 z-50 grid w-full max-w-md -translate-x-1/2 grid-cols-5 border-t border-white/10 bg-black/95 px-2 py-3 backdrop-blur-xl">
      {items.map(([href, icon, label, key]) => (
        <Link
          key={key}
          href={href}
          className={`flex flex-col items-center gap-1 py-1 text-[10px] font-semibold ${
            active === key ? 'text-fuchsia-400' : 'text-white/40'
          }`}
        >
          {key === 'create' ? (
            <span className="flex h-7 w-7 items-center justify-center rounded-full bg-white text-lg text-black">
              {icon}
            </span>
          ) : (
            <span className="text-lg">{icon}</span>
          )}

          {label}
        </Link>
      ))}
    </nav>
  )
}

function formatMessageTime(value?: string) {
  if (!value) return ''

  const date = new Date(value)

  if (Number.isNaN(date.getTime())) return ''

  const now = Date.now()
  const diff = now - date.getTime()

  if (diff < 60 * 1000) return 'now'

  if (diff < 60 * 60 * 1000) {
    return `${Math.floor(diff / (60 * 1000))}m`
  }

  if (diff < 24 * 60 * 60 * 1000) {
    return `${Math.floor(diff / (60 * 60 * 1000))}h`
  }

  if (diff < 7 * 24 * 60 * 60 * 1000) {
    return `${Math.floor(diff / (24 * 60 * 60 * 1000))}d`
  }

  return date.toLocaleDateString()
}
