'use client'

import Link from 'next/link'
import { useEffect, useState } from 'react'
import { createClient } from '@/lib/supabase'

type Post = {
  id: string
  user_id?: string
  content: string
  likes?: number
  comments?: number
  created_at: string
}

type Comment = {
  id: string
  content: string
  user_id: string
  created_at: string
}

export default function HomePage() {
  const supabase = createClient()

  const [posts, setPosts] = useState<Post[]>([])
  const [likedPosts, setLikedPosts] = useState<Record<string, boolean>>({})
  const [commentLists, setCommentLists] = useState<Record<string, Comment[]>>({})
  const [openComments, setOpenComments] = useState<Record<string, boolean>>({})
  const [commentText, setCommentText] = useState<Record<string, string>>({})
  const [postText, setPostText] = useState('')
  const [loading, setLoading] = useState(true)
  const [posting, setPosting] = useState(false)
  const [refreshing, setRefreshing] = useState(false)
  const [message, setMessage] = useState('')

  async function loadPosts(showRefresh = false) {
    if (showRefresh) setRefreshing(true)
    else setLoading(true)

    try {
      const response = await fetch('/api/posts', { cache: 'no-store' })

      if (!response.ok) {
        throw new Error('Unable to load posts')
      }

      const data = await response.json()
      const loadedPosts = Array.isArray(data) ? data : []

      setPosts(loadedPosts)

      const {
        data: { user },
      } = await supabase.auth.getUser()

      if (user && loadedPosts.length > 0) {
        const { data: likes } = await supabase
          .from('post_likes')
          .select('post_id')
          .eq('user_id', user.id)
          .in(
            'post_id',
            loadedPosts.map((post: Post) => post.id)
          )

        const likedMap: Record<string, boolean> = {}

        ;(likes || []).forEach((like: { post_id: string }) => {
          likedMap[like.post_id] = true
        })

        setLikedPosts(likedMap)
      }
    } catch {
      setMessage('Could not load the feed. Pull refresh and try again.')
    } finally {
      setLoading(false)
      setRefreshing(false)
    }
  }

  async function createPost() {
    const text = postText.trim()

    if (!text || posting) return

    setPosting(true)
    setMessage('')

    try {
      const {
        data: { user },
      } = await supabase.auth.getUser()

      if (!user) {
        setMessage('Please log in before creating a post.')
        return
      }

      const { data, error } = await supabase
        .from('posts')
        .insert({
          user_id: user.id,
          content: text,
        })
        .select('id, user_id, content, likes, comments, created_at')
        .single()

      if (error) throw error

      if (data) {
        setPosts((current) => [data as Post, ...current])
      }

      setPostText('')
    } catch {
      setMessage('Your post could not be published.')
    } finally {
      setPosting(false)
    }
  }

  async function toggleLike(post: Post) {
    try {
      const wasLiked = !!likedPosts[post.id]

      const response = await fetch('/api/posts/like', {
        method: wasLiked ? 'DELETE' : 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ postId: post.id }),
      })

      const result = await response.json()

      if (!response.ok) {
        throw new Error(result?.error || 'Like failed')
      }

      setLikedPosts((current) => ({
        ...current,
        [post.id]: !wasLiked,
      }))

      setPosts((current) =>
        current.map((item) =>
          item.id === post.id
            ? {
                ...item,
                likes:
                  typeof result.likes === 'number'
                    ? result.likes
                    : Math.max(0, Number(item.likes || 0) + (wasLiked ? -1 : 1)),
              }
            : item
        )
      )
    } catch {
      setMessage('Unable to update the like.')
    }
  }

  async function loadComments(postId: string) {
    try {
      const { data, error } = await supabase
        .from('post_comments')
        .select('id, content, user_id, created_at')
        .eq('post_id', postId)
        .order('created_at', { ascending: true })

      if (error) throw error

      setCommentLists((current) => ({
        ...current,
        [postId]: (data || []) as Comment[],
      }))
    } catch {
      setMessage('Unable to load comments.')
    }
  }

  async function toggleComments(postId: string) {
    const next = !openComments[postId]

    setOpenComments((current) => ({
      ...current,
      [postId]: next,
    }))

    if (next && !commentLists[postId]) {
      await loadComments(postId)
    }
  }

  async function addComment(postId: string) {
    const text = (commentText[postId] || '').trim()

    if (!text) return

    try {
      const {
        data: { user },
      } = await supabase.auth.getUser()

      if (!user) {
        setMessage('Please log in before commenting.')
        return
      }

      const { data, error } = await supabase
        .from('post_comments')
        .insert({
          post_id: postId,
          user_id: user.id,
          content: text,
        })
        .select('id, content, user_id, created_at')
        .single()

      if (error) throw error

      if (data) {
        setCommentLists((current) => ({
          ...current,
          [postId]: [...(current[postId] || []), data as Comment],
        }))

        setPosts((current) =>
          current.map((post) =>
            post.id === postId
              ? {
                  ...post,
                  comments: Number(post.comments || 0) + 1,
                }
              : post
          )
        )
      }

      setCommentText((current) => ({
        ...current,
        [postId]: '',
      }))
    } catch {
      setMessage('Your comment could not be posted.')
    }
  }

  async function sharePost(post: Post) {
    const shareText = post.content || 'Check this post on MOVETI Social'

    try {
      if (navigator.share) {
        await navigator.share({
          title: 'MOVETI Social',
          text: shareText,
          url: window.location.href,
        })
        return
      }

      await navigator.clipboard.writeText(
        `${shareText}\n\n${window.location.href}`
      )

      setMessage('Post link copied.')
      setTimeout(() => setMessage(''), 2200)
    } catch {
      // Share cancelled or unavailable.
    }
  }

  useEffect(() => {
    loadPosts()
  }, [])

  return (
    <main className="min-h-screen bg-[#09090b] text-white pb-28">
      <header className="sticky top-0 z-50 border-b border-white/10 bg-[#09090b]/95 backdrop-blur-xl">
        <div className="mx-auto flex h-[68px] max-w-[680px] items-center justify-between px-4">
          <div>
            <div className="text-[25px] font-black tracking-[-1.5px]">
              MOVETI
            </div>
            <div className="text-[10px] font-medium tracking-[3px] text-white/40">
              SOCIAL
            </div>
          </div>

          <div className="flex items-center gap-2">
            <Link
              href="/search"
              className="flex h-10 w-10 items-center justify-center rounded-full border border-white/10 bg-white/[0.05] text-lg"
              aria-label="Search"
            >
              ⌕
            </Link>

            <Link
              href="/notifications"
              className="flex h-10 w-10 items-center justify-center rounded-full border border-white/10 bg-white/[0.05] text-lg"
              aria-label="Notifications"
            >
              ♡
            </Link>

            <Link
              href="/profile"
              className="flex h-10 w-10 items-center justify-center rounded-full bg-white text-sm font-black text-black"
              aria-label="Profile"
            >
              C
            </Link>
          </div>
        </div>
      </header>

      <section className="mx-auto max-w-[680px] px-3 pt-4">
        <div className="mb-4 overflow-hidden rounded-[26px] border border-white/10 bg-[#111113]">
          <div className="flex items-center gap-3 overflow-x-auto px-4 py-4">
            <Link href="/profile" className="min-w-[68px] text-center">
              <div className="mx-auto mb-2 flex h-14 w-14 items-center justify-center rounded-full border border-white/20 bg-white text-xl font-black text-black">
                +
              </div>
              <div className="truncate text-[11px] text-white/70">
                Your story
              </div>
            </Link>

            <Link href="/discover" className="min-w-[68px] text-center">
              <div className="mx-auto mb-2 flex h-14 w-14 items-center justify-center rounded-full border border-white/10 bg-gradient-to-br from-fuchsia-500/70 via-purple-500/50 to-cyan-400/60 text-xl">
                ♫
              </div>
              <div className="truncate text-[11px] text-white/70">
                Music
              </div>
            </Link>

            <Link href="/discover" className="min-w-[68px] text-center">
              <div className="mx-auto mb-2 flex h-14 w-14 items-center justify-center rounded-full border border-white/10 bg-white/[0.08] text-xl">
                ✦
              </div>
              <div className="truncate text-[11px] text-white/70">
                Creators
              </div>
            </Link>

            <Link href="/live" className="min-w-[68px] text-center">
              <div className="mx-auto mb-2 flex h-14 w-14 items-center justify-center rounded-full border border-white/10 bg-white/[0.08] text-xl">
                ●
              </div>
              <div className="truncate text-[11px] text-white/70">
                Live
              </div>
            </Link>
          </div>
        </div>

        <div className="mb-4 flex gap-2 overflow-x-auto pb-1">
          <button className="whitespace-nowrap rounded-full bg-white px-5 py-2 text-xs font-bold text-black">
            For You
          </button>

          <button className="whitespace-nowrap rounded-full border border-white/10 bg-white/[0.05] px-5 py-2 text-xs font-semibold text-white/65">
            Following
          </button>

          <button className="whitespace-nowrap rounded-full border border-white/10 bg-white/[0.05] px-5 py-2 text-xs font-semibold text-white/65">
            Trending
          </button>

          <Link
            href="/discover"
            className="whitespace-nowrap rounded-full border border-white/10 bg-white/[0.05] px-5 py-2 text-xs font-semibold text-white/65"
          >
            Discover
          </Link>
        </div>

        <div className="mb-4 rounded-[26px] border border-white/10 bg-[#111113] p-4">
          <div className="flex items-center gap-3">
            <div className="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white text-sm font-black text-black">
              C
            </div>

            <div className="min-w-0 flex-1">
              <textarea
                value={postText}
                onChange={(event) => setPostText(event.target.value)}
                placeholder="What's happening?"
                rows={1}
                className="w-full resize-none bg-transparent py-2 text-sm text-white outline-none placeholder:text-white/35"
              />
            </div>
          </div>

          <div className="mt-3 flex items-center justify-between border-t border-white/10 pt-3">
            <div className="flex gap-1">
              <Link
                href="/creator"
                className="rounded-full px-3 py-2 text-xs font-semibold text-white/60 hover:bg-white/5"
              >
                Photo
              </Link>
              <Link
                href="/creator"
                className="rounded-full px-3 py-2 text-xs font-semibold text-white/60 hover:bg-white/5"
              >
                Video
              </Link>
              <Link
                href="/creator"
                className="rounded-full px-3 py-2 text-xs font-semibold text-white/60 hover:bg-white/5"
              >
                Music
              </Link>
            </div>

            <button
              onClick={createPost}
              disabled={!postText.trim() || posting}
              className="rounded-full bg-white px-5 py-2 text-xs font-black text-black disabled:cursor-not-allowed disabled:opacity-30"
            >
              {posting ? 'Posting...' : 'Post'}
            </button>
          </div>
        </div>

        {message && (
          <div className="mb-4 rounded-2xl border border-white/10 bg-white/[0.06] px-4 py-3 text-xs text-white/70">
            {message}
          </div>
        )}

        <div className="mb-4 flex items-center justify-between">
          <div>
            <h1 className="text-xl font-black tracking-tight">Your feed</h1>
            <p className="mt-1 text-xs text-white/35">
              Music, creators, videos and your community.
            </p>
          </div>

          <button
            onClick={() => loadPosts(true)}
            disabled={refreshing}
            className="rounded-full border border-white/10 bg-white/[0.05] px-4 py-2 text-xs font-bold text-white/70"
          >
            {refreshing ? 'Refreshing...' : 'Refresh'}
          </button>
        </div>

        {loading ? (
          <div className="space-y-4">
            {[1, 2, 3].map((item) => (
              <div
                key={item}
                className="animate-pulse rounded-[26px] border border-white/10 bg-[#111113] p-4"
              >
                <div className="mb-4 flex items-center gap-3">
                  <div className="h-11 w-11 rounded-full bg-white/10" />
                  <div className="space-y-2">
                    <div className="h-3 w-28 rounded bg-white/10" />
                    <div className="h-2 w-20 rounded bg-white/5" />
                  </div>
                </div>
                <div className="space-y-2">
                  <div className="h-3 w-full rounded bg-white/10" />
                  <div className="h-3 w-4/5 rounded bg-white/10" />
                </div>
              </div>
            ))}
          </div>
        ) : posts.length === 0 ? (
          <div className="rounded-[28px] border border-white/10 bg-[#111113] px-6 py-14 text-center">
            <div className="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-full bg-white/[0.06] text-2xl">
              ✦
            </div>
            <h2 className="text-lg font-black">Your feed is ready</h2>
            <p className="mx-auto mt-2 max-w-sm text-sm leading-6 text-white/40">
              Follow creators and publish your first post to start building
              your MOVETI community.
            </p>
            <Link
              href="/discover"
              className="mt-6 inline-flex rounded-full bg-white px-6 py-3 text-xs font-black text-black"
            >
              Discover creators
            </Link>
          </div>
        ) : (
          <div className="space-y-4">
            {posts.map((post) => (
              <article
                key={post.id}
                className="overflow-hidden rounded-[26px] border border-white/10 bg-[#111113]"
              >
                <div className="flex items-center gap-3 px-4 py-4">
                  <div className="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-white to-white/50 text-sm font-black text-black">
                    M
                  </div>

                  <div className="min-w-0 flex-1">
                    <div className="truncate text-sm font-black">
                      MOVETI Creator
                    </div>
                    <div className="text-[11px] text-white/35">
                      Community post
                    </div>
                  </div>

                  <button
                    className="px-2 text-lg text-white/35"
                    aria-label="Post options"
                  >
                    •••
                  </button>
                </div>

                <div className="px-4 pb-4">
                  <p className="whitespace-pre-wrap text-[15px] leading-6 text-white/90">
                    {post.content}
                  </p>
                </div>

                <div className="flex items-center justify-between border-t border-white/10 px-4 py-3 text-xs text-white/35">
                  <span>
                    {Number(post.likes || 0)}{' '}
                    {Number(post.likes || 0) === 1 ? 'like' : 'likes'}
                  </span>

                  <span>
                    {Number(post.comments || 0)}{' '}
                    {Number(post.comments || 0) === 1
                      ? 'comment'
                      : 'comments'}
                  </span>
                </div>

                <div className="grid grid-cols-3 border-t border-white/10">
                  <button
                    onClick={() => toggleLike(post)}
                    className={`py-3 text-xs font-bold transition ${
                      likedPosts[post.id]
                        ? 'text-white'
                        : 'text-white/50 hover:text-white'
                    }`}
                  >
                    {likedPosts[post.id] ? '♥ Liked' : '♡ Like'}
                  </button>

                  <button
                    onClick={() => toggleComments(post.id)}
                    className="border-x border-white/10 py-3 text-xs font-bold text-white/50 hover:text-white"
                  >
                    ◯ Comment
                  </button>

                  <button
                    onClick={() => sharePost(post)}
                    className="py-3 text-xs font-bold text-white/50 hover:text-white"
                  >
                    ↗ Share
                  </button>
                </div>

                {openComments[post.id] && (
                  <div className="border-t border-white/10 bg-black/20 px-4 py-4">
                    <div className="mb-3 space-y-3">
                      {(commentLists[post.id] || []).length === 0 ? (
                        <p className="text-xs text-white/35">
                          No comments yet. Start the conversation.
                        </p>
                      ) : (
                        (commentLists[post.id] || []).map((comment) => (
                          <div
                            key={comment.id}
                            className="rounded-2xl bg-white/[0.04] px-3 py-2"
                          >
                            <div className="mb-1 text-[10px] font-bold text-white/35">
                              MOVETI member
                            </div>
                            <div className="text-xs leading-5 text-white/80">
                              {comment.content}
                            </div>
                          </div>
                        ))
                      )}
                    </div>

                    <div className="flex gap-2">
                      <input
                        value={commentText[post.id] || ''}
                        onChange={(event) =>
                          setCommentText((current) => ({
                            ...current,
                            [post.id]: event.target.value,
                          }))
                        }
                        onKeyDown={(event) => {
                          if (event.key === 'Enter') {
                            addComment(post.id)
                          }
                        }}
                        placeholder="Write a comment..."
                        className="min-w-0 flex-1 rounded-full border border-white/10 bg-white/[0.05] px-4 py-2.5 text-xs text-white outline-none placeholder:text-white/30"
                      />

                      <button
                        onClick={() => addComment(post.id)}
                        className="rounded-full bg-white px-4 py-2 text-xs font-black text-black"
                      >
                        Send
                      </button>
                    </div>
                  </div>
                )}
              </article>
            ))}
          </div>
        )}
      </section>

      <nav className="fixed bottom-0 left-0 right-0 z-50 border-t border-white/10 bg-[#09090b]/95 backdrop-blur-xl">
        <div className="mx-auto flex h-[78px] max-w-[680px] items-center justify-around px-2">
          <Link
            href="/"
            className="flex flex-col items-center gap-1 text-[10px] font-black text-white"
          >
            <span className="text-xl">⌂</span>
            Home
          </Link>

          <Link
            href="/discover"
            className="flex flex-col items-center gap-1 text-[10px] font-semibold text-white/40"
          >
            <span className="text-xl">◉</span>
            Discover
          </Link>

          <Link
            href="/creator"
            className="flex h-12 w-14 items-center justify-center rounded-2xl bg-white text-2xl font-light text-black"
            aria-label="Create"
          >
            +
          </Link>

          <Link
            href="/messages"
            className="flex flex-col items-center gap-1 text-[10px] font-semibold text-white/40"
          >
            <span className="text-xl">◌</span>
            Messages
          </Link>

          <Link
            href="/profile"
            className="flex flex-col items-center gap-1 text-[10px] font-semibold text-white/40"
          >
            <span className="text-xl">●</span>
            Profile
          </Link>
        </div>
      </nav>
    </main>
  )
}
